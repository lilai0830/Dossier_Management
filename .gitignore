# Dossier_Management
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# ---------- Auto-generated runtime data (do not commit) ----------
chroma_projects/
screenshots/
output/
logs/

# ---------- Per-project dossier folders (new model) ----------
# Each user project lives at the repo root as PROJECT_ROOT/<project_name>/
# and is auto-classified into <project_name>/{CLINICAL,FE,CE}/.
# The classified report subfolders (and their PDFs/pptx/docx) are user
# data and must NOT enter version control.
**/CLINICAL/
**/FE/
**/CE/

# ---------- Legacy data/ layout (kept for backward compatibility) ----------
data/
data/**/*.pdf

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Env ----------
.env
.env.local

# ---------- Runtime index (auto-generated) ----------
index_projects/

# ---------- Archive / trash ----------
_trash/

# ---------- WorkBuddy local workspace memory (not for VCS) ----------
.workbuddy/

# ---------- User-configured watch folder (machine-specific path) ----------
listen_folder.txt

# ---------- Local reports / presentation materials ----------
汇报/
